{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LlamaStudio",
  "version": "0.1.8",
  "identifier": "com.llamastudio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LlamaStudio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "splash",
        "title": "",
        "url": "splash.html",
        "width": 360,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "transparent": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["llamaprofile"],
        "name": "LlamaStudio Profile",
        "description": "LlamaStudio server configuration profile",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"]
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
